# Copy this file to .env.local. Do not commit secrets.
# Firebase web keys are public identifiers; access is enforced by Auth + Firestore rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Set to 1 only when running against the local emulators.
VITE_USE_EMULATORS=0

# Optional overrides (also editable in Settings after sign-in)
VITE_RESOURCE_VERIFIER_URL=https://next-chance-navigator-staging.web.app/verify/
VITE_NAVIGATOR_URL=https://next-chance-navigator.web.app/navigator/

# Used by scripts/grant-admin.ts (not a security control)
ADMIN_EMAIL=
